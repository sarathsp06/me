---
import Layout from './Layout.astro';
import '../styles/blog-components.css';
import ReadingProgress from '../components/ReadingProgress.svelte';
import TableOfContents from '../components/TableOfContents.svelte';
import ArticleHeader from '../components/ArticleHeader.svelte';
import ShareButtons from '../components/ShareButtons.svelte';
import BlogFooter from '../components/BlogFooter.svelte';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, tags = [], readingTime = '5 min read' } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${title} | Sarath Sadasivan`} description={description}>
  <div class="min-h-screen bg-paper-bg text-paper-ink font-body">
    <ReadingProgress client:load />

    <div class="flex">
      <!-- Sidebar Navigation -->
      <div class="fixed left-0 top-0 h-full w-60 border-r border-paper-border p-6 hidden lg:flex print:!hidden flex-col bg-paper-bg/95 backdrop-blur-sm z-50">
        <TableOfContents client:load readingTime={readingTime} />
      </div>

      <!-- Main Content -->
      <main class="ml-0 lg:ml-60 print:!ml-0 w-full">
        <article class="max-w-3xl mx-auto px-6 md:px-10 py-12 md:py-20">
          <ArticleHeader
            client:load
            title={title}
            description={description}
            pubDate={formattedDate}
            tags={tags}
            readingTime={readingTime}
          />

          <!-- Content -->
          <div class="prose prose-lg max-w-none font-body leading-relaxed text-paper-ink
            prose-headings:font-display prose-headings:text-paper-ink prose-headings:font-bold
            prose-a:text-paper-link prose-a:no-underline hover:prose-a:underline
            prose-blockquote:border-l-paper-accent prose-blockquote:bg-paper-surface prose-blockquote:rounded-r
            prose-code:bg-paper-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
            prose-pre:bg-gray-900 prose-pre:text-gray-200 prose-pre:rounded-lg
            prose-img:rounded-lg prose-img:shadow-md">
            <slot />
          </div>

          <!-- Share section -->
          <div class="mt-12 pt-8 border-t border-paper-border print:hidden">
            <ShareButtons client:load title={title} />
          </div>

          <!-- Back link -->
          <div class="mt-8 pt-6 border-t border-paper-border/50 print:hidden">
            <a href="/blog" class="inline-flex items-center gap-2 text-sm text-paper-muted hover:text-paper-accent transition-colors group font-body">
              <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Back to all posts
            </a>
          </div>
        </article>

        <BlogFooter client:idle />
      </main>
    </div>
  </div>
</Layout>

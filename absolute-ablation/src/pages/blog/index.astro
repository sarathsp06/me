---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.svelte';
import BlogPostList from '../../components/BlogPostList.svelte';
import BlogFooter from '../../components/BlogFooter.svelte';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract all unique tags
const allTags = [...new Set(sortedPosts.flatMap(p => p.data.tags))];

// Format posts for the Svelte component
const formattedPosts = sortedPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  readingTime: post.data.readingTime || '',
  pubDate: post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  external: post.data.external || '',
  href: post.data.external || `/blog/${post.id}`,
}));
---

<Layout title="Blog | Sarath Sadasivan" description="Writing about software engineering, product management, and building things.">
  <div class="min-h-screen bg-paper-bg font-body">
    <BlogHeader client:load />

    <main class="max-w-3xl mx-auto px-6 py-12 md:py-20">
      <!-- Hero section -->
      <div class="mb-10">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-paper-ink mb-4 tracking-tight">
          Writing
        </h2>
        <p class="text-lg text-paper-muted leading-relaxed max-w-2xl font-body">
          Thoughts on software engineering, product management, prioritization, and building things that work.
        </p>

        <!-- Stats row -->
        <div class="stats-row">
          <div class="stat">
            <span class="stat-number">{sortedPosts.length}</span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">{allTags.length}</span>
            <span class="stat-label">Topics</span>
          </div>
        </div>
      </div>

      <!-- Interactive blog post list with filtering -->
      <BlogPostList
        client:load
        tags={allTags}
        posts={formattedPosts}
      />
    </main>

    <BlogFooter client:idle />
  </div>
</Layout>

<style>
  .stats-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-paper-border);
  }
  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .stat-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-paper-ink);
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--color-paper-muted);
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }
  .stat-divider {
    width: 1px;
    height: 1.5rem;
    background: var(--color-paper-border);
  }
</style>

        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" viewBox="-55 20 170 140" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 8 38 L 48 38 C 80 38, 105 50, 105 78 C 105 108, 82 120, 60 120 C 40 120, 26 108, 26 92 C 26 78, 36 70, 48 70 C 58 70, 64 78, 64 86 C 64 92, 60 96, 54 96" stroke="#00ADD8" stroke-width="7" stroke-linecap="round" fill="none"/>
              <path d="M 58 88 L 54 96 L 48 90" stroke="#00ADD8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span style="font-family: 'Fira Code', monospace;" class="text-sm"><span class="font-normal" style="color: hsl(220, 10%, 55%);">TEST</span><span class="font-bold text-white">HOOKS</span></span>
          </div>
          <p class="text-sm" style="color: hsl(220, 10%, 55%);">Self-hostable webhook inspector. Open source.</p>
          <div class="flex items-center gap-6">
            <a href="https://github.com/sarathsp06/testhooks" target="_blank" class="text-sm hover:text-cyan-400 transition-colors" style="color: hsl(220, 10%, 55%);">GitHub</a>
            <a href="https://testhooks.sarathsadasivan.com/" target="_blank" class="text-sm hover:text-cyan-400 transition-colors" style="color: hsl(220, 10%, 55%);">Live App</a>
          </div>
        </div>
      </div>
    </footer>
  </div>


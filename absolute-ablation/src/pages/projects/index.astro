---
import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    slug: 'sparrow',
    name: 'sparrow',
    icon: 'fa-brands fa-golang',
    iconColor: 'text-blue-400',
    tagline: 'Modern event-driven webhook delivery system with guaranteed delivery, intelligent retries, and complete observability.',
    tags: [
      { label: 'Go', color: 'bg-green-500/10 text-green-400' },
      { label: 'PostgreSQL', color: 'bg-blue-500/10 text-blue-400' },
      { label: 'gRPC', color: 'bg-purple-500/10 text-purple-400' },
      { label: 'SvelteKit', color: 'bg-orange-500/10 text-orange-400' },
    ],
    github: 'https://github.com/sarathsp06/sparrow',
    internal: true,
  },
  {
    slug: 'testhooks',
    name: 'testhooks',
    icon: 'fa-solid fa-satellite-dish',
    iconColor: 'text-emerald-400',
    tagline: 'A self-hostable webhook.site replacement. Capture, inspect, transform and forward webhooks in real time.',
    tags: [
      { label: 'Go', color: 'bg-green-500/10 text-green-400' },
      { label: 'Svelte', color: 'bg-purple-500/10 text-purple-400' },
      { label: 'Webhooks', color: 'bg-blue-500/10 text-blue-400' },
    ],
    github: 'https://github.com/sarathsp06/testhooks',
    link: 'https://testhooks.sarathsadasivan.com/',
    internal: true,
  },
  {
    slug: null,
    name: 'saraths_tools',
    icon: 'fa-solid fa-screwdriver-wrench',
    iconColor: 'text-yellow-400',
    tagline: 'A collection of useful web utilities and developer tools for daily productivity.',
    tags: [
      { label: 'Web', color: 'bg-purple-500/10 text-purple-400' },
      { label: 'Utilities', color: 'bg-slate-500/10 text-slate-300' },
    ],
    github: null,
    link: 'https://tools.sarathsadasivan.com/',
    internal: false,
  },
];
---

<Layout title="Projects | Sarath Sadasivan" description="Open source projects and tools by Sarath Sadasivan Pillai.">
  <div class="font-mono bg-[#0a0a0c] text-gray-300 leading-relaxed min-h-screen">
    <main class="max-w-4xl mx-auto p-4 md:p-8">
      <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <!-- Window Title Bar -->
        <div class="bg-[#1a1a1e] px-4 py-2 flex items-center gap-2 border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="text-[10px] text-slate-500 mx-auto uppercase tracking-widest text-center">bash &mdash; sarath &mdash; 80x24</div>
        </div>

        <!-- Content -->
        <div class="p-6 md:p-10">
          <nav class="mb-8 flex flex-wrap gap-4 text-xs md:text-sm">
            <a href="/" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ~</a>
            <a href="/blog" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./blogs/</a>
            <a href="/travel" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./travel/</a>
          </nav>

          <header class="mb-10">
            <div class="prompt text-sm md:text-base">ls -la ~/projects/</div>
            <h1 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-3">
              Projects<span class="cursor"></span>
            </h1>
            <p class="text-slate-400 text-sm max-w-2xl leading-relaxed">
              Open source tools and systems I've built. Mostly Go backends, webhook infrastructure, and developer utilities.
            </p>
            <div class="mt-4 text-slate-500 text-xs">
              total {projects.length}
            </div>
          </header>

          <div class="space-y-6">
            {projects.map(project => (
              <a
                href={project.internal && project.slug ? `/projects/${project.slug}` : (project.link || project.github)}
                target={project.internal ? undefined : '_blank'}
                rel={project.internal ? undefined : 'noopener noreferrer'}
                class="project-card block border border-white/10 p-6 rounded transition-all"
              >
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3">
                    <i class={`${project.icon} text-2xl ${project.iconColor}`}></i>
                    <div>
                      <span class="text-white font-bold text-lg">{project.name}</span>
                      {project.internal && <span class="ml-2 text-[10px] px-2 py-0.5 bg-teal-500/10 text-teal-400 rounded">landing page</span>}
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    {project.github && (
                      <span class="text-slate-500 text-xs hover:text-slate-300 transition-colors">
                        <i class="fab fa-github"></i>
                      </span>
                    )}
                    <i class={`fas ${project.internal ? 'fa-arrow-right' : 'fa-external-link-alt'} text-xs text-slate-500`}></i>
                  </div>
                </div>
                <p class="text-slate-400 text-sm mb-4 leading-relaxed">{project.tagline}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map(tag => (
                    <span class={`text-[10px] px-2 py-0.5 rounded ${tag.color}`}>{tag.label}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>

          <!-- Footer -->
          <footer class="mt-16 opacity-40 text-[10px]">
            <p class="text-center">
              <a href="/" class="text-green-400 hover:underline text-sm font-bold transition-colors">cd ~ (Home)</a>
            </p>
          </footer>
        </div>
      </div>
    </main>
  </div>

  <style>
    .prompt::before {
      content: "sarath@dev:~$ ";
      color: #4ade80;
      font-weight: bold;
    }
    .cursor {
      display: inline-block;
      width: 10px;
      height: 20px;
      background-color: #4ade80;
      animation: blink 1s step-end infinite;
      vertical-align: middle;
      margin-left: 4px;
    }
    .project-card:hover {
      border-color: #4ade80;
      background: rgba(74, 222, 128, 0.05);
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
  </style>
</Layout>

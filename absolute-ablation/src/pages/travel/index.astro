---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.svelte';
import BlogFooter from '../../components/BlogFooter.svelte';
import { resolveImage } from '../../lib/images';

const posts = await getCollection('travel');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Travel | Sarath Sadasivan" description="Stories from the road. Places visited, things learned, moments captured.">
  <div class="min-h-screen bg-paper-bg font-body">
    <BlogHeader client:load activePage="travel" />

    <main class="max-w-3xl mx-auto px-6 py-12 md:py-20">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-paper-ink mb-4">Travel Log</h2>
        <p class="text-lg text-paper-muted leading-relaxed max-w-2xl">Stories from the road. Places visited, things learned, moments captured.</p>
      </div>

      {sortedPosts.length === 0 ? (
        <p class="text-paper-muted text-center py-20 font-body italic">No travel logs yet. Adventures are being planned.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedPosts.map((post) => (
            <a href={`/travel/${post.id}`} class="block group">
              <article class="travel-card">
                {post.data.coverImage && (
                  <div class="h-48 bg-paper-surface overflow-hidden">
                    <img src={resolveImage(post.data.coverImage)} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  </div>
                )}
                <div class="p-5">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    {post.data.location && (
                      <span class="text-xs text-paper-accent flex items-center gap-1 font-body italic">
                        <i class="fas fa-map-marker-alt text-[0.6rem]"></i> {post.data.location}
                      </span>
                    )}
                    {post.data.readingTime && (
                      <span class="text-xs text-paper-muted flex items-center gap-1">
                        <i class="far fa-clock text-[0.6rem]"></i> {post.data.readingTime}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-display font-bold text-paper-ink mb-2 group-hover:text-paper-accent transition-colors">{post.data.title}</h3>
                  <p class="text-paper-muted text-sm leading-relaxed mb-3 font-body">{post.data.description}</p>
                  <div class="flex items-center justify-between">
                    <div class="flex flex-wrap gap-1.5">
                      {post.data.tags.slice(0, 3).map((tag: string) => (
                        <span class="inline-block px-2 py-0.5 rounded text-[0.6rem] font-semibold uppercase tracking-wide bg-paper-surface text-paper-accent border border-paper-border">{tag}</span>
                      ))}
                    </div>
                    <p class="text-xs text-paper-muted font-body">
                      {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                    </p>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      )}
    </main>

    <BlogFooter client:idle />
  </div>
</Layout>

<style>
  .travel-card {
    border: 1px solid var(--color-paper-border);
    overflow: hidden;
    background: var(--color-paper-bg);
    transition: all 0.2s ease;
  }
  .travel-card:hover {
    border-color: var(--color-paper-accent);
    box-shadow: 0 4px 12px rgba(139, 69, 19, 0.08);
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="sarath@unix:~" description="Sarath Sadasivan Pillai - Engineering Director, Tech Lead & Distributed Systems Engineer">
  <div class="font-mono bg-[#0a0a0c] text-gray-300 leading-relaxed min-h-screen">
    <!-- Scanline effect -->
    <div class="fixed w-full h-[100px] z-50 pointer-events-none opacity-10"
      style="background: linear-gradient(0deg, rgba(0,0,0,0) 0%, rgba(255,255,255,0.02) 50%, rgba(0,0,0,0) 100%); animation: scanline 10s linear infinite;">
    </div>

    <main class="max-w-4xl mx-auto p-4 md:p-8">
      <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <!-- Window Title Bar -->
        <div class="bg-[#1a1a1e] px-4 py-2 flex items-center gap-2 border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="text-[10px] text-slate-500 mx-auto uppercase tracking-widest text-center">bash &mdash; sarath &mdash; 80x24</div>
        </div>

        <!-- Terminal Content -->
        <div class="p-6 md:p-10">
          <!-- Main Bio Section -->
          <div id="view-bio">
            <header class="mb-12">
              <div class="prompt text-sm md:text-base">whoami</div>
              <h1 class="text-3xl md:text-5xl font-bold text-white mt-2 mb-4">
                Sarath Sadasivan Pillai<span class="cursor"></span>
              </h1>
              <div class="text-slate-400 max-w-2xl text-sm md:text-base leading-relaxed mb-4">
                <span class="text-blue-400">Engineering Director</span> · <span class="text-blue-400">Tech Lead</span> · <span class="text-blue-400">Distributed Systems</span><br />
                Based in Rotterdam, NL (hybrid / EU remote). Specializing in <span class="text-green-400 font-semibold">Go, Distributed Systems, API Design, Observability</span>.
              </div>
              <p class="text-slate-500 text-sm max-w-2xl leading-relaxed">
                I build reliable, scalable backend systems. Currently Director of Engineering at WellSync and co-founding a product company -- I enjoy the overlap of engineering depth and product thinking.
              </p>
            </header>

            <nav class="mb-12 flex flex-wrap gap-4 text-xs md:text-sm">
              <a href="/travel" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./travel/</a>
              <a href="/blog" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./blogs/</a>
              <a href="/projects" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./projects/</a>
              <a href="#tools-section" class="text-green-400 hover:text-green-300 font-bold transition-colors">cd ./bin/</a>
              <a href="#experience-section" class="text-slate-400 hover:text-slate-300 font-bold transition-colors">cd ./experience/</a>
              <a href="https://www.linkedin.com/in/sarathsp/" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">linkedin</a>
              <a href="https://github.com/sarathsp06" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">github</a>
              <a href="mailto:sarath.sp06@gmail.com" class="text-blue-400 hover:text-blue-300 transition-colors">email</a>
              <a href="https://github.com/sarathsp06/me/raw/master/cv/cv.pdf" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">cv ↓</a>
            </nav>

            <!-- Experience Section -->
            <section id="experience-section" class="mb-12">
              <div class="prompt text-sm md:text-base mb-6">git log --graph career</div>
              <ol class="career">
                <li class="commit is-current">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">WellSync</span> <span class="head-tag">HEAD</span>
                    <span class="text-slate-300 text-sm">Director of Engineering</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2024 – now</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">Leading engineering at a medtech company. Mostly reliability, observability, and getting Sparrow into production.</p>
                </li>
                <li class="commit is-current">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">Message+</span> <span class="head-tag">HEAD</span>
                    <span class="text-slate-300 text-sm">Co-founder &amp; CTO</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2022 – now</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">A side company I started. I wrote the whole Go backend for customer support over WhatsApp and Instagram.</p>
                </li>
                <li class="commit">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">Shell</span>
                    <span class="text-slate-300 text-sm">Senior Software Engineer</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2020 – 2024</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">Sustainability and regulatory reporting, where late or wrong data becomes a compliance problem.</p>
                </li>
                <li class="commit">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">MessageBird</span>
                    <span class="text-slate-300 text-sm">Senior Software Engineer</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2019 – 2020</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">Real-time call handling in Go: setting calls up, connecting them, and ending them cleanly.</p>
                </li>
                <li class="commit">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">Onefootball</span>
                    <span class="text-slate-300 text-sm">Software Engineer</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2019</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">Backend for live pay-per-view match streaming in the mobile apps.</p>
                </li>
                <li class="commit">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-green-400 font-bold">Exotel</span>
                    <span class="text-slate-300 text-sm">Technical Lead</span>
                    <span class="text-slate-500 text-xs md:ml-auto tabular-nums">2014 – 2018</span>
                  </div>
                  <p class="text-slate-400 text-sm leading-relaxed mt-1 max-w-2xl">Joined as roughly employee 18. Moved the platform from PHP, Ruby, and Java to Go and led the API team.</p>
                </li>
              </ol>
            </section>

            <!-- Stack Section -->
            <section class="mb-24">
              <div class="prompt text-sm md:text-base mb-4">cat ~/.config/stack.toml</div>
              <pre class="stack text-sm leading-7 overflow-x-auto"><code><span class="text-blue-400">lang    </span> <span class="text-slate-500">=</span> <span class="text-slate-500">[</span><span class="text-green-400">"go", "python", "sql", "svelte"</span><span class="text-slate-500">]</span> <span class="text-slate-600"># go: primary, ~10 years</span>
<span class="text-blue-400">systems </span> <span class="text-slate-500">=</span> <span class="text-slate-500">[</span><span class="text-green-400">"distributed", "event-driven", "real-time"</span><span class="text-slate-500">]</span>
<span class="text-blue-400">apis    </span> <span class="text-slate-500">=</span> <span class="text-slate-500">[</span><span class="text-green-400">"rest", "grpc", "webhooks"</span><span class="text-slate-500">]</span>
<span class="text-blue-400">ops     </span> <span class="text-slate-500">=</span> <span class="text-slate-500">[</span><span class="text-green-400">"grafana", "opentelemetry", "error budgets"</span><span class="text-slate-500">]</span>
<span class="text-blue-400">domains </span> <span class="text-slate-500">=</span> <span class="text-slate-500">[</span><span class="text-green-400">"telecom", "medtech", "regulated data"</span><span class="text-slate-500">]</span></code></pre>
            </section>
          </div>

          <!-- Tools Section -->
          <div id="tools-section" class="pt-12 border-t border-white/10 mb-24">
            <header class="mb-8">
              <div class="prompt text-sm">ls -F ~/bin/</div>
              <h2 class="text-2xl font-bold text-white mt-2">Tools & Projects</h2>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <a href="https://sarathsp06.github.io/sparrow/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-brands fa-golang text-2xl text-blue-400"></i>
                  <span class="text-white font-bold text-lg">sparrow*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Event-driven webhook delivery system with guaranteed delivery, intelligent retries, and full observability.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-blue-500/10 text-blue-400 rounded">Webhooks</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">gRPC</span>
                </div>
              </a>

              <a href="https://sdsvn.github.io/co-review/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-code-compare text-xl text-sky-400"></i>
                  <span class="text-white font-bold text-lg">co-review*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Open your whole repository as a review and read it with the coding agent that wrote it. Ask why, and know your code again.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-sky-500/10 text-sky-400 rounded">Code Review</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">AI Agents</span>
                </div>
              </a>

              <a href="https://sarathsp06.github.io/janusfs/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-user-secret text-xl text-amber-400"></i>
                  <span class="text-white font-bold text-lg">janusfs*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Secret-masking filesystem for AI agents. Secrets read as ****, byte length preserved, kernel-enforced on Linux.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-amber-500/10 text-amber-400 rounded">FUSE</span>
                  <span class="text-[10px] px-2 py-0.5 bg-red-500/10 text-red-400 rounded">Security</span>
                </div>
              </a>

              <a href="https://sarathsp06.github.io/herdrweb/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-inbox text-xl text-pink-400"></i>
                  <span class="text-white font-bold text-lg">herdrweb*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Your coding agents in one inbox, on any device. A mobile-first web client for the Herdr agent multiplexer, shipped as one Go binary.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-orange-500/10 text-orange-400 rounded">SvelteKit</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">AI Agents</span>
                </div>
              </a>

              <a href="https://testhooks.vercel.app/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-satellite-dish text-xl text-emerald-400"></i>
                  <span class="text-white font-bold text-lg">testhooks*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">A self-hostable webhook.site replacement. Capture, inspect, transform and forward webhooks in real time.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">Svelte</span>
                  <span class="text-[10px] px-2 py-0.5 bg-blue-500/10 text-blue-400 rounded">Webhooks</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Footer -->
          <footer class="mt-20 opacity-40 text-[10px]">
            <p>Last login: <span id="current-time"></span> on ttys001</p>
            <p class="mt-8 text-center">
              <a href="#" class="text-green-400 hover:underline text-sm font-bold transition-colors">cd ~ (Return to Top)</a>
            </p>
          </footer>
        </div>
      </div>
    </main>
  </div>

  <script>
    const el = document.getElementById('current-time');
    if (el) el.textContent = new Date().toUTCString();
  </script>

  <style>
    .prompt::before {
      content: "sarath@dev:~$ ";
      color: #4ade80;
      font-weight: bold;
    }
    .cmd-output {
      border-left: 2px solid #334155;
      padding-left: 1.5rem;
      margin-top: 0.5rem;
      margin-bottom: 2rem;
    }
    .cursor {
      display: inline-block;
      width: 10px;
      height: 20px;
      background-color: #4ade80;
      animation: blink 1s step-end infinite;
      vertical-align: middle;
      margin-left: 4px;
    }
    .career {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      padding-left: 1.75rem;
    }
    .career::before {
      content: "";
      position: absolute;
      left: 0.3rem;
      top: 0.5rem;
      bottom: 0.5rem;
      border-left: 2px solid #334155;
    }
    .commit {
      position: relative;
    }
    .commit::before {
      content: "";
      position: absolute;
      left: -1.75rem;
      top: 0.45rem;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 9999px;
      background: #0a0a0c;
      border: 2px solid #64748b;
    }
    .commit.is-current::before {
      border-color: #4ade80;
      background: #4ade80;
    }
    .head-tag {
      font-size: 10px;
      padding: 0 0.4rem;
      border: 1px solid rgba(250, 204, 21, 0.5);
      color: #facc15;
      border-radius: 3px;
    }
    .stack {
      border-left: 2px solid #334155;
      padding-left: 1.5rem;
    }
    .tool-card:hover {
      border-color: #4ade80;
      background: rgba(74, 222, 128, 0.05);
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    @keyframes scanline {
      0% { bottom: 100%; }
      100% { bottom: -100%; }
    }
  </style>
</Layout>

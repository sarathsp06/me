---
import Layout from '../layouts/Layout.astro';
---

<Layout title="sarath@unix:~" description="Sarath Sadasivan Pillai - Engineering Director, Tech Lead & Distributed Systems Engineer">
  <div class="font-mono bg-[#0a0a0c] text-gray-300 leading-relaxed min-h-screen">
    <!-- Scanline effect -->
    <div class="fixed w-full h-[100px] z-50 pointer-events-none opacity-10"
      style="background: linear-gradient(0deg, rgba(0,0,0,0) 0%, rgba(255,255,255,0.02) 50%, rgba(0,0,0,0) 100%); animation: scanline 10s linear infinite;">
    </div>

    <main class="max-w-4xl mx-auto p-4 md:p-8">
      <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <!-- Window Title Bar -->
        <div class="bg-[#1a1a1e] px-4 py-2 flex items-center gap-2 border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="text-[10px] text-slate-500 mx-auto uppercase tracking-widest text-center">bash &mdash; sarath &mdash; 80x24</div>
        </div>

        <!-- Terminal Content -->
        <div class="p-6 md:p-10">
          <!-- Main Bio Section -->
          <div id="view-bio">
            <header class="mb-12">
              <div class="prompt text-sm md:text-base">whoami</div>
              <h1 class="text-3xl md:text-5xl font-bold text-white mt-2 mb-4">
                Sarath Sadasivan Pillai<span class="cursor"></span>
              </h1>
              <div class="text-slate-400 max-w-2xl text-sm md:text-base leading-relaxed mb-4">
                <span class="text-blue-400">Engineering Director</span> · <span class="text-blue-400">Tech Lead</span> · <span class="text-blue-400">Distributed Systems</span><br />
                Based in Rotterdam, NL (hybrid / EU remote). Specializing in <span class="text-green-400 font-semibold">Go, Distributed Systems, API Design, Observability</span>.
              </div>
              <p class="text-slate-500 text-sm max-w-2xl leading-relaxed mb-3">
                Engineering leader and hands-on tech lead with 12+ years designing and running distributed backend systems in Go. Today I am Director of Engineering at WellSync, a medtech company, where I lead the team and its technical direction on services that handle sensitive health data, and co-founder and CTO of Message+.
              </p>
              <p class="text-slate-500 text-sm max-w-2xl leading-relaxed">
                Earlier I drove Exotel's platform-wide migration from PHP/Ruby/Java to Go and led its API team on a 99.999% SLA platform, then built real-time voice infrastructure at MessageBird, a live-streaming backend at Onefootball, and compliance-critical data systems at Shell. I work at staff level: shaping architecture across teams, setting engineering standards, mentoring engineers, and turning reliability goals into decisions that business, legal, and regulatory stakeholders can follow.
              </p>
            </header>

            <nav class="mb-12 flex flex-wrap gap-4 text-xs md:text-sm">
              <a href="/travel" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./travel/</a>
              <a href="/blog" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./blogs/</a>
              <a href="/projects" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">cd ./projects/</a>
              <a href="#tools-section" class="text-green-400 hover:text-green-300 font-bold transition-colors">cd ./bin/</a>
              <a href="#experience-section" class="text-slate-400 hover:text-slate-300 font-bold transition-colors">cd ./experience/</a>
              <a href="https://www.linkedin.com/in/sarathsp/" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">linkedin</a>
              <a href="https://github.com/sarathsp06" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">github</a>
              <a href="mailto:sarath.sp06@gmail.com" class="text-blue-400 hover:text-blue-300 transition-colors">email</a>
              <a href="https://github.com/sarathsp06/me/raw/master/cv/cv.pdf" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">cv ↓</a>
            </nav>

            <!-- Skills Section -->
            <section class="mb-12">
              <div class="prompt text-sm md:text-base mb-4">cat /proc/skills</div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Languages</h3>
                  <div class="text-green-400 font-medium">Go (primary, ~10 yrs), Python, SQL, JavaScript/Svelte, Java, PHP</div>
                </div>
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Systems</h3>
                  <div class="text-green-400 font-medium">Distributed systems, event-driven architecture, REST &amp; gRPC API design, webhooks, delivery guarantees &amp; retries, high-throughput real-time services</div>
                </div>
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Reliability</h3>
                  <div class="text-green-400 font-medium">Observability, monitoring &amp; logging (Grafana, OpenTelemetry), incident review, SLAs, error budgets</div>
                </div>
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Data &amp; Tools</h3>
                  <div class="text-green-400 font-medium">PostgreSQL, MySQL, Linux, gRPC, SvelteKit, Claude Code (agentic development)</div>
                </div>
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Domains</h3>
                  <div class="text-green-400 font-medium">Cloud communications / CPaaS (voice, SMS, messaging), real-time media, medtech &amp; health data, regulated systems (GDPR, telecom, audit)</div>
                </div>
                <div class="bg-white/5 p-4 rounded border border-white/5">
                  <h3 class="text-slate-500 font-bold mb-2 uppercase text-xs tracking-wider">Leadership</h3>
                  <div class="text-green-400 font-medium">Technical direction, mentoring, coding standards &amp; review, working with product, business, and legal stakeholders</div>
                </div>
              </div>
            </section>

            <!-- Experience Section -->
            <section id="experience-section" class="mb-24">
              <div class="prompt text-sm md:text-base mb-4">ls -la ~/experience/</div>
              <div class="space-y-10">
                <!-- Wellsync -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">Wellsync::Director_of_Engineering</span>
                    <span class="text-slate-500 text-xs">Aug 2024 - Present</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Medtech · Rotterdam / Barendrecht, NL</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Lead the engineering team and its technical direction as hands-on tech lead.<br />
                    &bull; Led development of new revenue-generating services with strong reliability guarantees.<br />
                    &bull; Improved system observability so production behaviour is easier to detect, investigate, and document.<br />
                    &bull; Mentored engineers on development and release practices, reducing production problems.<br />
                    &bull; Brought Sparrow, my own webhook delivery system, into production use.
                  </div>
                </div>
                <!-- Message+ -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">Message+::Co-Founder_&amp;_CTO</span>
                    <span class="text-slate-500 text-xs">Dec 2022 - Present</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Multi-channel customer support · remote, part-time</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Co-founded the company and own its technical direction.<br />
                    &bull; Sole backend developer: built the Go backend, including the AI-assisted support component.<br />
                    &bull; Designed scalable enterprise messaging infrastructure; launched on WhatsApp first, then Instagram.<br />
                    &bull; Work directly with customers on integration, contracts, and compliance expectations.
                  </div>
                </div>
                <!-- Shell -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">Shell::Senior_Software_Engineer</span>
                    <span class="text-slate-500 text-xs">Nov 2020 - Aug 2024</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Rotterdam, NL</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Built and maintained data-driven systems for sustainability and regulatory reporting, where data quality and timeliness were compliance-critical.<br />
                    &bull; Worked with business stakeholders on product strategy, internal controls, and audit expectations.<br />
                    &bull; Designed systems to be easy to monitor, explain, and adjust as regulation changed.
                  </div>
                </div>
                <!-- MessageBird -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">MessageBird::Senior_Software_Engineer</span>
                    <span class="text-slate-500 text-xs">Jun 2019 - Nov 2020</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Amsterdam, NL</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Built core real-time call-handling logic in Go: call setup, connection, and completion.<br />
                    &bull; Kept voice services stable against strict service-level and contractual requirements; improved API availability.<br />
                    &bull; Introduced clearer monitoring and incident review, reducing downtime; established shared coding and review practices.
                  </div>
                </div>
                <!-- Onefootball -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">Onefootball::Software_Engineer</span>
                    <span class="text-slate-500 text-xs">Feb 2019 - Jun 2019</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Berlin, DE</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Built the backend for OTT video delivery in the mobile apps, enabling live pay-per-view match streaming under hard latency constraints.
                  </div>
                </div>
                <!-- Exotel -->
                <div>
                  <div class="flex flex-col md:flex-row justify-between mb-1">
                    <span class="text-green-400 font-bold underline">Exotel::Technical_Lead</span>
                    <span class="text-slate-500 text-xs">May 2014 - Dec 2018</span>
                  </div>
                  <div class="text-slate-500 text-xs mb-2">Bengaluru, IN</div>
                  <div class="cmd-output text-sm leading-relaxed">
                    &bull; Joined as roughly employee 18; the company scaled to ~200 and became Asia’s largest cloud telephony platform.<br />
                    &bull; Led the migration of the full platform from PHP/Ruby/Java to Go.<br />
                    &bull; Owned the usage-based billing system: ran the Java version, then rewrote it in Go.<br />
                    &bull; Led the API team and guided public API and SDK design on a 99.999% SLA platform.<br />
                    &bull; Led teams scaling core calling and messaging systems, and delivered Exotel’s first mobile app on a short timeline.
                  </div>
                </div>
              </div>
            </section>
          </div>

          <!-- Tools Section -->
          <div id="tools-section" class="pt-12 border-t border-white/10 mb-24">
            <header class="mb-8">
              <div class="prompt text-sm">ls -F ~/bin/</div>
              <h2 class="text-2xl font-bold text-white mt-2">Tools & Projects</h2>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <a href="https://sarathsp06.github.io/sparrow/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-brands fa-golang text-2xl text-blue-400"></i>
                  <span class="text-white font-bold text-lg">sparrow*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Event-driven webhook delivery system with guaranteed delivery, intelligent retries, and full observability.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-blue-500/10 text-blue-400 rounded">Webhooks</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">gRPC</span>
                </div>
              </a>

              <a href="https://sdsvn.github.io/co-review/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-code-compare text-xl text-sky-400"></i>
                  <span class="text-white font-bold text-lg">co-review*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Open your whole repository as a review and read it with the coding agent that wrote it. Ask why, and know your code again.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-sky-500/10 text-sky-400 rounded">Code Review</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">AI Agents</span>
                </div>
              </a>

              <a href="https://sarathsp06.github.io/janusfs/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-user-secret text-xl text-amber-400"></i>
                  <span class="text-white font-bold text-lg">janusfs*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Secret-masking filesystem for AI agents. Secrets read as ****, byte length preserved, kernel-enforced on Linux.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-amber-500/10 text-amber-400 rounded">FUSE</span>
                  <span class="text-[10px] px-2 py-0.5 bg-red-500/10 text-red-400 rounded">Security</span>
                </div>
              </a>

              <a href="https://sarathsp06.github.io/herdrweb/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-inbox text-xl text-pink-400"></i>
                  <span class="text-white font-bold text-lg">herdrweb*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">Your coding agents in one inbox, on any device. A mobile-first web client for the Herdr agent multiplexer, shipped as one Go binary.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-orange-500/10 text-orange-400 rounded">SvelteKit</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">AI Agents</span>
                </div>
              </a>

              <a href="https://testhooks.vercel.app/" target="_blank" class="tool-card block border border-white/10 p-5 rounded transition-all">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-satellite-dish text-xl text-emerald-400"></i>
                  <span class="text-white font-bold text-lg">testhooks*</span>
                </div>
                <p class="text-slate-400 text-sm mb-4">A self-hostable webhook.site replacement. Capture, inspect, transform and forward webhooks in real time.</p>
                <div class="flex gap-3">
                  <span class="text-[10px] px-2 py-0.5 bg-green-500/10 text-green-400 rounded">Go</span>
                  <span class="text-[10px] px-2 py-0.5 bg-purple-500/10 text-purple-400 rounded">Svelte</span>
                  <span class="text-[10px] px-2 py-0.5 bg-blue-500/10 text-blue-400 rounded">Webhooks</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Footer -->
          <footer class="mt-20 opacity-40 text-[10px]">
            <p>Last login: <span id="current-time"></span> on ttys001</p>
            <p class="mt-8 text-center">
              <a href="#" class="text-green-400 hover:underline text-sm font-bold transition-colors">cd ~ (Return to Top)</a>
            </p>
          </footer>
        </div>
      </div>
    </main>
  </div>

  <script>
    const el = document.getElementById('current-time');
    if (el) el.textContent = new Date().toUTCString();
  </script>

  <style>
    .prompt::before {
      content: "sarath@dev:~$ ";
      color: #4ade80;
      font-weight: bold;
    }
    .cmd-output {
      border-left: 2px solid #334155;
      padding-left: 1.5rem;
      margin-top: 0.5rem;
      margin-bottom: 2rem;
    }
    .cursor {
      display: inline-block;
      width: 10px;
      height: 20px;
      background-color: #4ade80;
      animation: blink 1s step-end infinite;
      vertical-align: middle;
      margin-left: 4px;
    }
    .tool-card:hover {
      border-color: #4ade80;
      background: rgba(74, 222, 128, 0.05);
    }
    @keyframes blink {
      50% { opacity: 0; }
    }
    @keyframes scanline {
      0% { bottom: 100%; }
      100% { bottom: -100%; }
    }
  </style>
</Layout>
